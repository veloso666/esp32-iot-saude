  "panels": [
    {
      "id": 10,
      "type": "gapit-htmlgraphics-panel",
      "title": "",
      "transparent": true,
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "add100Percentage": true, "centerAlignContent": false, "overflow": "hidden",
        "renderOnMount": true, "reloadOnDashboardRefresh": false, "panelupdateOnMount": true,
        "dynamicData": false, "dynamicFieldDisplayValues": false, "dynamicHtmlProps": false, "codeData": "{}",
        "html": "<div class='bnr'><div><div class='bt'>Projeto de Experimentos (DoE)</div><div class='bs'>Comparacao de tecnologias de comunicacao IoT &middot; WiFi / LoRaWAN / 6LoWPAN &middot; arquitetura multi-cloud</div></div><div class='bb'>CIn / UFPE</div></div>",
        "css": ".bnr{display:flex;align-items:center;justify-content:space-between;font-family:Inter,Segoe UI,Roboto,sans-serif;color:#e8eef7;background:linear-gradient(135deg,#0b3d91,#1f6feb);border-radius:16px;padding:18px 24px;box-shadow:0 8px 24px rgba(0,0,0,.4)} .bt{font-size:24px;font-weight:800;letter-spacing:.3px} .bs{font-size:13px;opacity:.9;margin-top:5px} .bb{font-size:13px;font-weight:700;opacity:.85;border:1px solid rgba(255,255,255,.4);border-radius:10px;padding:8px 12px;white-space:nowrap}",
        "onInit": "", "onRender": ""
      }
    },
    {
      "id": 11,
      "type": "gapit-htmlgraphics-panel",
      "title": "",
      "transparent": true,
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C" },
      "targets": [
        { "refId": "PROTO", "format": "table", "datasource": { "type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C" }, "rawQuery": true, "rawSql": "SELECT protocolo, count(*) AS n, round(avg((fields->>'latencia_ms')::numeric),1) AS lat, round(avg((fields->>'pdr')::numeric),3) AS pdr, round(avg((fields->>'jitter_ms')::numeric),1) AS jitter, round(avg((fields->>'rssi')::numeric),1) AS rssi, round(avg((fields->>'energia_mah')::numeric),3) AS energia FROM metricas_iot WHERE time > now() - interval '1 hour' AND protocolo IN ('wifi','lorawan','6lowpan') GROUP BY protocolo ORDER BY protocolo" }
      ],
      "options": {
        "add100Percentage": true, "centerAlignContent": false, "overflow": "auto",
        "renderOnMount": true, "reloadOnDashboardRefresh": true, "panelupdateOnMount": true,
        "dynamicData": true, "dynamicFieldDisplayValues": false, "dynamicHtmlProps": false, "codeData": "{}",
        "html": "<div id='proto' class='grid proto'></div>",
        "css": ".grid{display:grid;gap:14px;font-family:Inter,Segoe UI,Roboto,sans-serif;color:#e8eef7} .proto{grid-template-columns:repeat(3,1fr)} .card{background:#12171f;border:1px solid #222b36;border-radius:16px;padding:18px 20px;box-shadow:0 4px 16px rgba(0,0,0,.3);position:relative;overflow:hidden;transition:transform .15s} .card:hover{transform:translateY(-2px)} .accent{position:absolute;top:0;left:0;height:5px;width:100%} .pname{font-size:20px;font-weight:800;margin-bottom:8px} .metric{display:flex;justify-content:space-between;align-items:center;font-size:13px;margin-top:9px;opacity:.92} .metric b{font-weight:800;font-size:14px} .bar{height:8px;border-radius:5px;background:#222b36;margin-top:6px;overflow:hidden} .bar>span{display:block;height:100%;border-radius:5px} .muted{opacity:.5;font-size:11px;margin-top:14px}",
        "onInit": "",
        "onRender": "const series=(data&&data.series)||[];const fv=f=>{let v=f.values;if(v&&typeof v.toArray==='function')v=v.toArray();return v;};const asObj=fr=>{const o={};fr.fields.forEach(f=>o[f.name]=fv(f));return o;};let P=null;series.forEach(fr=>{const n=fr.fields.map(f=>f.name);if(n.indexOf('protocolo')>=0)P=asObj(fr);});const q=s=>htmlNode.querySelector(s);if(P&&q('#proto')){const col={wifi:'#3fb950',lorawan:'#f0883e','6lowpan':'#58a6ff'};const nm={wifi:'WiFi',lorawan:'LoRaWAN','6lowpan':'6LoWPAN'};let h='';for(let i=0;i<P.protocolo.length;i++){const p=P.protocolo[i];const c=col[p]||'#8b949e';const pdr=Number(P.pdr[i]||0);h+=`<div class='card'><div class='accent' style='background:${c}'></div><div class='pname' style='color:${c}'>${nm[p]||p}</div><div class='metric'><span>Latencia media</span><b>${P.lat[i]} ms</b></div><div class='metric'><span>Jitter</span><b>${P.jitter[i]} ms</b></div><div class='metric'><span>RSSI</span><b>${P.rssi[i]} dBm</b></div><div class='metric'><span>Energia</span><b>${P.energia[i]} mAh</b></div><div class='metric'><span>PDR</span><b>${(pdr*100).toFixed(1)}%</b></div><div class='bar'><span style='width:${(pdr*100).toFixed(1)}%;background:${c}'></span></div><div class='muted'>${P.n[i]} amostras (ult. 1h)</div></div>`;}q('#proto').innerHTML=h;}"
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Latencia media por protocolo (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "format": "time_series", "datasource": { "type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C" }, "rawQuery": true, "rawSql": "SELECT $__timeGroupAlias(time,$__interval), protocolo AS metric, avg((fields->>'latencia_ms')::float8) AS value FROM metricas_iot WHERE $__timeFilter(time) AND protocolo IN ('wifi','lorawan','6lowpan') GROUP BY 1, protocolo ORDER BY 1" }
      ]
    },
